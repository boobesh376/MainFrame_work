
IDENTIFICATION DIVISION.
PROGRAM-ID. STUDENT-SPLIT.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.

    SELECT STUDENT-FILE ASSIGN TO STUDIN
        ORGANIZATION IS SEQUENTIAL.

    SELECT UG-FILE ASSIGN TO UGOUT
        ORGANIZATION IS SEQUENTIAL.

    SELECT PG-FILE ASSIGN TO PGOUT
        ORGANIZATION IS SEQUENTIAL.

DATA DIVISION.
FILE SECTION.

FD STUDENT-FILE.
01 STUDENT-REC.
   05 STU-ID       PIC X(3).
   05 STU-NAME     PIC X(10).
   05 STU-DEGREE   PIC X(3).
   05 STU-DEPT     PIC X(5).

FD UG-FILE.
01 UG-REC          PIC X(21).

FD PG-FILE.
01 PG-REC          PIC X(21).

WORKING-STORAGE SECTION.

01 WS-STU-REC.
   05 WS-ID        PIC X(3).
   05 WS-NAME      PIC X(10).
   05 WS-DEGREE    PIC X(3).
   05 WS-DEPT      PIC X(5).

01 WS-EOF           PIC X VALUE 'N'.
01 WS-INVALID-COUNT PIC 9(3) VALUE 0.

PROCEDURE DIVISION.

MAIN-PARA.

    OPEN INPUT STUDENT-FILE
    OPEN OUTPUT UG-FILE PG-FILE

    PERFORM UNTIL WS-EOF = 'Y'

        READ STUDENT-FILE INTO WS-STU-REC
            AT END
                MOVE 'Y' TO WS-EOF
            NOT AT END
                EVALUATE WS-DEGREE

                    WHEN 'UG '
                        WRITE UG-REC FROM WS-STU-REC

                    WHEN 'PG ' ALSO 'PHD'
                        WRITE PG-REC FROM WS-STU-REC

                    WHEN OTHER
                        ADD 1 TO WS-INVALID-COUNT

                END-EVALUATE
        END-READ

    END-PERFORM

    CLOSE STUDENT-FILE UG-FILE PG-FILE

    DISPLAY 'INVALID RECORDS: ' WS-INVALID-COUNT

    STOP RUN.
